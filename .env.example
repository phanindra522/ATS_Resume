# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, gemini, anthropic, local
LLM_PROVIDER_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4.1-mini # LLM model for text generation (e.g., gpt-3.5-turbo, gemini-pro)
# Embedding Model
LLM_EMBEDDING_MODEL=text-embedding-3-small # Embedding model (e.g., text-embedding-ada-002, text-embedding-004)
EMBEDDING_DIMENSION=1536 # 1536 for OpenAI, 768 for Gemini

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=ats_scoring
CHROMA_PERSIST_DIRECTORY=./chroma_db

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Security Configuration
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Enhancement Settings for Multi-Agent System
USE_LLM_FOR_KEYWORDS=true      # Enable LLM for keyword extraction
USE_LLM_FOR_SKILLS=true        # Enable LLM for skill normalization
USE_LLM_FOR_EXPERIENCE=true    # Enable LLM for experience analysis
USE_LLM_FOR_EDUCATION=true     # Enable LLM for education analysis

# LLM Fallback Settings
LLM_FALLBACK_ENABLED=true      # Enable fallback to rule-based when LLM fails
LLM_TIMEOUT_SECONDS=10         # Timeout for LLM API calls
LLM_RETRY_ATTEMPTS=2           # Number of retry attempts for failed LLM calls